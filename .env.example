PORT=3001
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed browser origins (production)
# CORS_ALLOWED_ORIGINS=https://astrology-frontend.vercel.app,https://astrology-admin-eta.vercel.app
MONGO_URI=mongodb://localhost:27017
MONGO_DB=jyotish
JWT_SECRET=change-me
# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json
# For Vercel/serverless: paste the full service account JSON as one line (no file needed)
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1

# Legacy fallback — used only if GEMINI_MODEL_CHAT is unset
GEMINI_MODEL=gemini-2.5-flash

# Tiered model routing
GEMINI_MODEL_CHAT=gemini-2.5-pro
GEMINI_MODEL_CHAT_FALLBACKS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_MODEL_WELCOME=gemini-2.5-flash
GEMINI_MODEL_WELCOME_FALLBACKS=gemini-2.5-flash-lite
GEMINI_MODEL_SUMMARY=gemini-2.5-flash-lite
GEMINI_MODEL_SUMMARY_FALLBACKS=gemini-2.5-flash

# Output + reasoning budgets (-1 = dynamic thinking where supported)
GEMINI_CHAT_MAX_OUTPUT=8192
GEMINI_CHAT_THINKING_BUDGET=-1
GEMINI_COMPLEX_THINKING_BUDGET=16384
GEMINI_WELCOME_MAX_OUTPUT=1024
GEMINI_WELCOME_THINKING_BUDGET=0
GEMINI_SUMMARY_MAX_OUTPUT=512
GEMINI_SUMMARY_THINKING_BUDGET=0

# Auto-used for gemini-3* model ids
ADMIN_EMAIL=admin
ADMIN_PASSWORD=123456
ADMIN_URL=http://localhost:5175
# Production admin portal:
# ADMIN_URL=https://astrology-admin-eta.vercel.app

# Optional maximum depth:
# GEMINI_MODEL_CHAT=gemini-3.1-pro-preview
